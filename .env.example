# ==============================================
# APU Tigers Basketball - Environment Variables
# ==============================================

# Email Configuration (REQUIRED for email verification & password reset)
# For Gmail: Use App Password (https://myaccount.google.com/apppasswords)
# Not your regular Gmail password!
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-app-specific-password

# Base URL (REQUIRED for email links)
# Development: http://localhost:3000
# Production: https://your-domain.com
BASE_URL=http://localhost:3000

# Server Configuration
PORT=3000
NODE_ENV=development

# Session Secret (REQUIRED - MUST change in production!)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change_this_to_a_random_secret_string_in_production_minimum_32_characters

# ==============================================
# Database Configuration
# ==============================================

# Option 1: PostgreSQL (Production - Recommended)
# Uncomment and set your PostgreSQL connection string when deploying
# Format: postgresql://username:password@host:port/database_name
# DATABASE_URL=postgresql://username:password@localhost:5432/apu_tigers

# Option 2: SQLite (Development - Default)
# No configuration needed - uses local users.sqlite and sessions.sqlite files
# Automatically used when DATABASE_URL is not set

# ==============================================
# Optional: Admin Configuration
# ==============================================
# First user email to automatically set as admin
# ADMIN_EMAIL=admin@apu.edu.my

# ==============================================
# Security Settings
# ==============================================
# Token expiration times (in hours)
VERIFICATION_TOKEN_EXPIRY=24
RESET_TOKEN_EXPIRY=1

# Session expiration (in milliseconds)
SESSION_MAX_AGE=86400000
